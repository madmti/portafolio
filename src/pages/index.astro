<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loading...</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #ffffff;
            color: #05DF72;
            font-family: system-ui, -apple-system, sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .loading-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2rem;
        }

        .arch-logo {
            width: 120px;
            height: 120px;
            opacity: 0;
            animation: fadeIn 0.3s ease-in-out 0.1s forwards;
        }

        .progress-container {
            width: 200px;
            height: 4px;
            background: #e5e7eb;
            border-radius: 2px;
            overflow: hidden;
            opacity: 0;
            animation: fadeIn 0.3s ease-in-out 0.2s forwards;
        }

        .progress-bar {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #05DF72, #04bf63);
            border-radius: 2px;
            animation: fillProgress 0.5s ease-out 0.3s forwards;
        }

        .loading-text {
            color: #6b7280;
            font-size: 14px;
            font-weight: 500;
            opacity: 0;
            animation: fadeIn 0.3s ease-in-out 0.4s forwards;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fillProgress {
            from {
                width: 0%;
            }
            to {
                width: 100%;
            }
        }

        /* Arch Linux logo image styling */
        .arch-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <div class="loading-container">
        <div class="arch-logo">
            <img
                src="/archlinux.webp"
                alt="Arch Linux Logo"
            />
        </div>

        <div class="progress-container">
            <div class="progress-bar"></div>
        </div>

        <div class="loading-text">
            Loading portfolio...
        </div>
    </div>

    <script>
        // Redirect after animation completes
        setTimeout(() => {
            window.location.href = '/es/';
        }, 1000); // Total time: 0.3s (logo) + 0.5s (progress) + 0.2s (buffer)

        // Allow user to skip by clicking or pressing key
        document.addEventListener('click', function() {
            window.location.href = '/es/';
        });

        document.addEventListener('keydown', function(e) {
            if (e.code === 'Space' || e.code === 'Enter' || e.code === 'Escape') {
                window.location.href = '/es/';
            }
        });
    </script>
</body>
</html>
