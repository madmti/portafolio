---
// i18n
import { ui } from "@/i18n/ui";
const lang = (Astro.currentLocale || "es") as "es" | "en";
const t = ui[lang];
---

<nav class="fixed top-4 left-0 right-0 z-50 px-4">
    <div class="flex items-center justify-between gap-4 max-w-7xl mx-auto">
        <!-- Left section - Menu Islands -->
        <div class="flex items-center gap-4">
            <!-- Navigation Menu Island -->
            <div
                class="bg-base-100 shadow-lg rounded-full px-3 py-1 border border-base-300 h-10 flex items-center"
            >
                <div class="flex items-center gap-1">
                    <a
                        href="#home"
                        class="nav-link px-2 py-1 text-sm font-medium text-base-content/80 hover:text-base-content hover:bg-base-200 rounded-lg transition-colors"
                    >
                        {t.nav.home}
                    </a>
                    <a
                        href="#about"
                        class="nav-link px-2 py-1 text-sm font-medium text-base-content/80 hover:text-base-content hover:bg-base-200 rounded-lg transition-colors"
                    >
                        {t.nav.academic}
                    </a>
                    <a
                        href="#projects"
                        class="nav-link px-2 py-1 text-sm font-medium text-base-content/80 hover:text-base-content hover:bg-base-200 rounded-lg transition-colors"
                    >
                        {t.nav.projects}
                    </a>
                    <a
                        href="#contact"
                        class="nav-link px-2 py-1 text-sm font-medium text-base-content/80 hover:text-base-content hover:bg-base-200 rounded-lg transition-colors"
                    >
                        {t.nav.contact}
                    </a>
                </div>
            </div>
        </div>

        <!-- Center section - Clock Island -->
        <div
            class="bg-base-100 shadow-lg rounded-full px-4 py-1 border border-base-300 h-10 flex items-center"
        >
            <div class="text-sm font-mono text-base-content">
                <span id="date-display"></span>
            </div>
        </div>

        <!-- Right section - System indicators Islands -->
        <div class="flex items-center gap-4">
            <!-- Language Switcher Island -->
            <div
                class="bg-base-100 shadow-lg rounded-full px-3 py-1 border border-base-300 h-10 flex items-center"
            >
                <div class="dropdown dropdown-end">
                    <div tabindex="0" role="button" class="btn btn-ghost btn-xs gap-1 text-base-content/80 hover:text-base-content">
                        <svg class="w-4 h-4" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0014.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
                        </svg>
                        <span id="current-lang" class="text-xs font-medium">ES</span>
                        <svg class="w-3 h-3" viewBox="0 0 20 20">
                            <path fill="currentColor" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/>
                        </svg>
                    </div>
                    <ul tabindex="0" class="dropdown-content menu bg-base-100 border border-base-300 rounded-box z-[1] w-20 p-1 shadow-lg">
                        <li>
                            <button class="lang-option text-xs justify-center" data-lang="es">
                                🇨🇱 ES
                            </button>
                        </li>
                        <li>
                            <button class="lang-option text-xs justify-center" data-lang="en">
                                🇺🇸 EN
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- System Status Island -->
            <div
                class="bg-base-100 shadow-lg rounded-full px-3 py-1 border border-base-300 h-10 flex items-center"
            >
                <div class="flex items-center gap-3">
                    <!-- Network indicator -->
                    <div
                        class="flex items-center gap-1 text-xs text-base-content/80"
                    >
                        <svg class="w-4 h-4" viewBox="0 0 24 24"
                            ><path
                                fill="#000000"
                                d="M12 21q-1.05 0-1.775-.725T9.5 18.5t.725-1.775T12 16t1.775.725t.725 1.775t-.725 1.775T12 21m-5.65-5.65l-2.1-2.15q1.475-1.475 3.463-2.337T12 10t4.288.875t3.462 2.375l-2.1 2.1q-1.1-1.1-2.55-1.725T12 13t-3.1.625t-2.55 1.725M2.1 11.1L0 9q2.3-2.35 5.375-3.675T12 4t6.625 1.325T24 9l-2.1 2.1q-1.925-1.925-4.462-3.012T12 7T6.563 8.088T2.1 11.1"
                            ></path></svg
                        >
                        <span>eduroam</span>
                    </div>

                    <!-- Audio indicator -->
                    <div
                        class="flex items-center gap-1 text-xs text-base-content/80"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.707.707L4.586 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.586l3.707-3.707a1 1 0 011.09-.217zM15.657 6.343a1 1 0 011.414 1.414A4.98 4.98 0 0118 10a4.98 4.98 0 01-.929 2.243 1 1 0 11-1.414-1.414A2.98 2.98 0 0016 10c0-.746-.156-1.456-.343-2.657z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>75%</span>
                    </div>

                    <!-- Battery indicator -->
                    <div
                        class="flex items-center gap-1 text-xs text-base-content/80"
                    >
                        <svg class="w-4 h-4" viewBox="0 0 24 24"
                            ><g fill="#000000"
                                ><path
                                    d="M6 15a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h6v6z"
                                ></path><path
                                    fill-rule="evenodd"
                                    d="M18 6H5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h13a3 3 0 0 0 3-3a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1a3 3 0 0 0-3-3m0 2H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1"
                                    clip-rule="evenodd"></path></g
                            ></svg
                        >
                        <span>85%</span>
                    </div>
                </div>
            </div>

            <!-- User Island -->
            <div
                class="bg-base-100 shadow-lg rounded-full px-3 py-1 border border-base-300 h-10 flex items-center"
            >
                <span
                    class="text-sm font-medium font-mono text-base-content/80 mx-2"
                >
                    madmti
                </span>
                <div class="avatar">
                    <picture class="w-6 rounded-xl overflow-hidden">
                        <img
                            src="https://avatars.githubusercontent.com/u/134110830?v=4"
                            alt="User Avatar"
                            class="w-6 h-6"
                        />
                    </picture>
                </div>
            </div>
        </div>
    </div>
</nav>

<style>
    /* Base nav link styles */
    .nav-link {
        position: relative;
        transition: all 0.2s ease;
    }

    /* Active nav link styling */
    .nav-link.active {
        background: rgb(var(--base-200));
        color: rgb(var(--base-content));
        font-weight: 600;
    }

    /* Small active indicator */
    .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 3px;
        height: 3px;
        background: rgb(var(--primary));
        border-radius: 50%;
    }

    /* Language dropdown styling */
    .dropdown-content {
        margin-top: 0.5rem;
    }

    .lang-option:hover {
        background: rgb(var(--base-200));
    }

    .lang-option.active {
        background: rgb(var(--primary));
        color: rgb(var(--primary-content));
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        // Update date display
        const dateDisplay = document.getElementById("date-display");
        const now = new Date();
        const formattedDate = now.toLocaleDateString("es-ES", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
        });
        dateDisplay.textContent = formattedDate;

        // Handle active nav link highlighting
        function updateActiveLink() {
            const navLinks = document.querySelectorAll('.nav-link');
            const currentHash = window.location.hash || '#home';

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === currentHash) {
                    link.classList.add('active');
                }
            });
        }

        // Update on page load
        updateActiveLink();

        // Update when hash changes
        window.addEventListener('hashchange', updateActiveLink);

        // Language switcher functionality
        const currentLangSpan = document.getElementById('current-lang');
        const langOptions = document.querySelectorAll('.lang-option');

        // Get current language from URL or default to 'es'
        const currentPath = window.location.pathname;
        const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';

        // Update current language display
        currentLangSpan.textContent = currentLang.toUpperCase();

        // Mark active language option
        langOptions.forEach(option => {
            const lang = option.getAttribute('data-lang');
            if (lang === currentLang) {
                option.classList.add('active');
            } else {
                option.classList.remove('active');
            }
        });

        // Handle language change
        langOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                const selectedLang = this.getAttribute('data-lang');
                const currentPath = window.location.pathname;
                const currentHash = window.location.hash;

                let newPath;
                if (selectedLang === 'en') {
                    // Switch to English
                    if (currentPath === '/' || currentPath === '/es' || currentPath === '/es/') {
                        newPath = '/en/';
                    } else if (currentPath.startsWith('/es/')) {
                        newPath = currentPath.replace('/es/', '/en/');
                    } else if (!currentPath.startsWith('/en/')) {
                        newPath = '/en' + currentPath;
                    } else {
                        newPath = currentPath;
                    }
                } else {
                    // Switch to Spanish
                    if (currentPath.startsWith('/en/')) {
                        newPath = currentPath.replace('/en/', '/');
                    } else if (currentPath === '/en') {
                        newPath = '/';
                    } else {
                        newPath = currentPath;
                    }
                }

                // Close dropdown before navigating
                document.activeElement.blur();

                // Navigate to the new path with the current hash
                window.location.href = newPath + currentHash;
            });
        });
    });
</script>
