---
// Qt-style window component with slot for content
interface Props {
    title: string;
    icon?: string;
    className?: string;
}

const { title, icon = "github", className = "" } = Astro.props;

// Generate unique IDs for this window instance
const windowId = `qt-window-${Math.random().toString(36).substr(2, 9)}`;
const titleBarId = `qt-titlebar-${Math.random().toString(36).substr(2, 9)}`;

const iconSvg = {
    github: `<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>`,
    folder: `<path d="M10 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>`,
    terminal: `<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM4 6h16v2H4V6zm0 12V10h16v8H4z"/><path d="M6 12h2v2H6zm4 0h8v2h-8z"/>`,
    linkedin: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
    email: `<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>`
};
---

<div class={`qt-window bg-base-100 border border-base-300 rounded-lg shadow-xl overflow-hidden max-w-3xl w-full opacity-85 hover:opacity-100 transition-all duration-200 ${className}`} id={windowId}>
    <!-- Window Title Bar -->
    <div class="bg-gradient-to-b from-base-200 to-base-300 border-b border-base-300 flex justify-between items-center px-3 py-2 h-8 select-none cursor-move" id={titleBarId}>
        <div class="flex items-center gap-2">
            <div class="text-base-content/60">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <Fragment set:html={iconSvg[icon]} />
                </svg>
            </div>
            <span class="text-sm font-semibold text-base-content">{title}</span>
        </div>
    </div>

    <!-- Window Content -->
    <div class="p-5 bg-base-100">
        <slot />
    </div>
</div>

<script is:inline define:vars={{ windowId, titleBarId }}>
document.addEventListener('DOMContentLoaded', function() {
    const qtWindow = document.getElementById(windowId);
    const titleBar = document.getElementById(titleBarId);

    if (!qtWindow || !titleBar) return;

    let isDragging = false;
    let currentX;
    let currentY;
    let initialX;
    let initialY;
    let xOffset = 0;
    let yOffset = 0;

    // Preserve width and set position for dragging
    const computedStyle = getComputedStyle(qtWindow);
    const windowWidth = qtWindow.offsetWidth;

    qtWindow.style.position = 'relative';
    qtWindow.style.width = windowWidth + 'px';
    qtWindow.style.zIndex = '1000';
    qtWindow.style.margin = '0';

    titleBar.addEventListener('mousedown', dragStart);
    document.addEventListener('mousemove', dragMove);
    document.addEventListener('mouseup', dragEnd);

    function dragStart(e) {
        if (e.target.closest('button')) return; // Don't drag when clicking buttons

        initialX = e.clientX - xOffset;
        initialY = e.clientY - yOffset;

        if (e.target === titleBar || titleBar.contains(e.target)) {
            isDragging = true;
            qtWindow.style.cursor = 'grabbing';
        }
    }

    function dragMove(e) {
        if (isDragging) {
            e.preventDefault();

            currentX = e.clientX - initialX;
            currentY = e.clientY - initialY;

            xOffset = currentX;
            yOffset = currentY;

            setTranslate(currentX, currentY, qtWindow);
        }
    }

    function dragEnd(e) {
        initialX = currentX;
        initialY = currentY;
        isDragging = false;
        qtWindow.style.cursor = '';
    }

    function setTranslate(xPos, yPos, el) {
        el.style.transform = `translate(${xPos}px, ${yPos}px)`;
    }
});
</script>

<style>
    .qt-window {
        transition: all 0.2s ease-in-out;
    }

    .qt-window:hover {
        border-color: #00ff41 !important;
        box-shadow: 0 0 10px rgba(0, 255, 65, 0.3) !important;
    }
</style>
