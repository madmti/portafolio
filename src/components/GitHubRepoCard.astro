---
export interface Props {
    name: string;
    description: string;
    language?: string;
    languageColor?: string;
    stars?: number;
    isPublic?: boolean;
    url: string;
}

const {
    name,
    description,
    language,
    languageColor = "#6B7280",
    stars = 0,
    isPublic = true,
    url,
} = Astro.props;
---

<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="block bg-base-300 border border-base-300 rounded-lg p-4 hover:bg-base-200 transition-colors duration-200 cursor-pointer"
>
    <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 16 16"
                ><path
                    fill="#000000"
                    d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7a.75.75 0 1 1-1.072 1.05A2.5 2.5 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.5 2.5 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"
                ></path></svg
            >
            <span class="font-medium">
                {name}
            </span>
        </div>
        <span class="badge badge-ghost badge-sm text-xs">
            {isPublic ? "Public" : "Private"}
        </span>
    </div>

    <p class="text-sm text-base-content/70 mb-3">
        {description}
    </p>

    <div class="flex items-center gap-4 text-xs text-base-content/60">
        {
            language && (
                <div class="flex items-center gap-1">
                    <span
                        class="w-3 h-3 rounded-full inline-block"
                        style={`background-color: ${languageColor}`}
                    />
                    <span>{language}</span>
                </div>
            )
        }

        {
            stars > 0 && (
                <div class="flex items-center gap-1">
                    <svg
                        class="w-3 h-3"
                        viewBox="0 0 16 16"
                        fill="currentColor"
                    >
                        <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z" />
                    </svg>
                    <span>{stars}</span>
                </div>
            )
        }
    </div>
</a>
