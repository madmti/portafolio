---
// Firefox-style window component with slot for content
interface Props {
    title: string;
    url?: string;
    favicon?: string;
    className?: string;
}

const { title, url = "https://github.com/madmti", favicon = "github", className = "" } = Astro.props;

// Generate unique IDs for this window instance
const windowId = `firefox-window-${Math.random().toString(36).substr(2, 9)}`;
const titleBarId = `firefox-titlebar-${Math.random().toString(36).substr(2, 9)}`;

const faviconSvg = {
    github: `<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>`,
    web: `<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>`,
    folder: `<path d="M10 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>`
};
---

<div class={`bg-base-100 border border-base-300 rounded-lg shadow-2xl overflow-hidden max-w-4xl w-full ${className}`} id={windowId}>
    <!-- Firefox Title Bar -->
    <div class="bg-gradient-to-r from-orange-500 to-orange-600 flex justify-between items-center px-3 py-2 h-10 select-none cursor-move" id={titleBarId}>
        <div class="flex items-center gap-3">
            <!-- Firefox Menu Button -->
            <button class="text-white/80 hover:text-white hover:bg-white/10 rounded p-1 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
                </svg>
            </button>
            <!-- Firefox Logo -->
            <div class="text-white">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.89 0C5.33 0 0 5.33 0 11.89s5.33 11.89 11.89 11.89 11.89-5.33 11.89-11.89S18.45 0 11.89 0zm5.65 15.5c-1.4 2.3-3.9 3.8-6.7 3.8-4.4 0-8-3.6-8-8s3.6-8 8-8c1.8 0 3.4.6 4.7 1.6-.9-.4-1.9-.6-2.9-.6-3.3 0-6 2.7-6 6s2.7 6 6 6c1.7 0 3.2-.7 4.3-1.9.6-1.1.9-2.3.9-3.6 0-.4 0-.8-.1-1.2.6 1.1.9 2.4.9 3.7 0 .7-.1 1.4-.2 2.1z"/>
                </svg>
            </div>
        </div>
        
        <div class="flex items-center gap-2 text-white text-sm font-medium">
            <span class="truncate max-w-xs">{title}</span>
        </div>

        <!-- Window Controls -->
        <div class="flex gap-2">
            <button class="text-white/80 hover:text-white hover:bg-white/10 rounded p-1 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 13H5v-2h14v2z"/>
                </svg>
            </button>
            <button class="text-white/80 hover:text-white hover:bg-white/10 rounded p-1 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 4h16v16H4V4zm2 2v12h12V6H6z"/>
                </svg>
            </button>
            <button class="text-white/80 hover:text-white hover:bg-red-600 rounded p-1 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Firefox Tab Bar -->
    <div class="bg-base-200 border-b border-base-300 flex items-center px-3">
        <div class="bg-base-100 border border-base-300 border-b-0 rounded-t-lg px-3 py-1.5 flex items-center gap-2 max-w-xs">
            <div class="text-base-content/60 flex-shrink-0">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <Fragment set:html={faviconSvg[favicon]} />
                </svg>
            </div>
            <span class="text-sm text-base-content truncate">{title}</span>
            <button class="text-base-content/40 hover:text-base-content/80 flex-shrink-0">
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
            </button>
        </div>
        <button class="ml-2 text-base-content/40 hover:text-base-content/80 p-1">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
        </button>
    </div>

    <!-- Firefox Address Bar -->
    <div class="bg-base-200 border-b border-base-300 px-3 py-2">
        <div class="flex items-center gap-3">
            <!-- Navigation buttons -->
            <div class="flex items-center gap-1">
                <button class="btn btn-ghost btn-sm btn-circle">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                    </svg>
                </button>
                <button class="btn btn-ghost btn-sm btn-circle">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                    </svg>
                </button>
                <button class="btn btn-ghost btn-sm btn-circle">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                    </svg>
                </button>
            </div>
            
            <!-- Address bar -->
            <div class="flex-1 bg-base-100 border border-base-300 rounded px-3 py-2 flex items-center gap-2">
                <svg class="w-4 h-4 text-success" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                </svg>
                <span class="text-sm text-base-content/80 flex-1 truncate">{url}</span>
                <svg class="w-4 h-4 text-base-content/40" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
            </div>

            <!-- Menu button -->
            <button class="btn btn-ghost btn-sm btn-circle">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Window Content -->
    <div class="p-6 bg-base-100 min-h-96">
        <slot />
    </div>
</div>

<script is:inline define:vars={{ windowId, titleBarId }}>
document.addEventListener('DOMContentLoaded', function() {
    const firefoxWindow = document.getElementById(windowId);
    const titleBar = document.getElementById(titleBarId);
    
    if (!firefoxWindow || !titleBar) return;
    
    let isDragging = false;
    let currentX;
    let currentY;
    let initialX;
    let initialY;
    let xOffset = 0;
    let yOffset = 0;

    // Preserve width and set position for dragging
    const computedStyle = getComputedStyle(firefoxWindow);
    const windowWidth = firefoxWindow.offsetWidth;
    
    firefoxWindow.style.position = 'relative';
    firefoxWindow.style.width = windowWidth + 'px';
    firefoxWindow.style.zIndex = '1000';
    firefoxWindow.style.margin = '0';

    titleBar.addEventListener('mousedown', dragStart);
    document.addEventListener('mousemove', dragMove);
    document.addEventListener('mouseup', dragEnd);

    function dragStart(e) {
        if (e.target.closest('button')) return; // Don't drag when clicking buttons
        
        initialX = e.clientX - xOffset;
        initialY = e.clientY - yOffset;

        if (e.target === titleBar || titleBar.contains(e.target)) {
            isDragging = true;
            firefoxWindow.style.cursor = 'grabbing';
        }
    }

    function dragMove(e) {
        if (isDragging) {
            e.preventDefault();
            
            currentX = e.clientX - initialX;
            currentY = e.clientY - initialY;

            xOffset = currentX;
            yOffset = currentY;

            setTranslate(currentX, currentY, firefoxWindow);
        }
    }

    function dragEnd(e) {
        initialX = currentX;
        initialY = currentY;
        isDragging = false;
        firefoxWindow.style.cursor = '';
    }

    function setTranslate(xPos, yPos, el) {
        el.style.transform = `translate(${xPos}px, ${yPos}px)`;
    }
});
</script>