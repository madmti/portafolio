---
// ASCII 3D Donut Component
---

<div class="donut-container">
    <pre id="donut" class="donut-ascii"></pre>
</div>

<style>
    .donut-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
        background: var(--color-base-100, transparent);
        font-family: "Courier New", monospace;
        overflow: hidden;
        pointer-events: none;
    }

    .donut-ascii {
        color: #00ff41;
        font-size: 8px;
        line-height: 8px;
        letter-spacing: 1px;
        text-shadow: 0 0 5px #00ff41;
        white-space: pre;
        margin: 0;
        animation: glow 2s ease-in-out infinite alternate;
    }

    @keyframes glow {
        from {
            text-shadow:
                0 0 5px #00ff41,
                0 0 10px #00ff41;
        }
        to {
            text-shadow:
                0 0 10px #00ff41,
                0 0 20px #00ff41,
                0 0 30px #00ff41;
        }
    }

    @media (min-width: 768px) {
        .donut-ascii {
            font-size: 12px;
            line-height: 12px;
        }
    }
</style>

<script>
    let A = 1,
        B = 1;
    const donutElement = document.getElementById("donut");

    function renderDonut() {
        const b = [];
        const z = [];

        // Initialize arrays
        for (let i = 0; i < 1760; i++) {
            b[i] = i % 80 === 79 ? "\n" : " ";
            z[i] = 0;
        }

        for (let j = 0; j < 628; j += 7) {
            // j <=> theta
            for (let i = 0; i < 628; i += 2) {
                // i <=> phi
                const c = Math.sin(i);
                const d = Math.cos(j);
                const e = Math.sin(A);
                const f = Math.sin(j);
                const g = Math.cos(A);
                const h = d + 2;
                const D = 1 / (c * h * e + f * g + 5);
                const l = Math.cos(i);
                const m = Math.cos(B);
                const n = Math.sin(B);
                const t = c * h * g - f * e;

                const x = Math.floor(40 + 30 * D * (l * h * m - t * n));
                const y = Math.floor(12 + 15 * D * (l * h * n + t * m));
                const o = Math.floor(x + 80 * y);
                const N = Math.floor(
                    8 *
                        ((f * e - c * d * g) * m -
                            c * d * e -
                            f * g -
                            l * d * n),
                );

                if (y < 22 && y >= 0 && x >= 0 && x < 79 && D > z[o]) {
                    z[o] = D;
                    b[o] = ".,-~:;=!*#$@"[N > 0 ? N : 0];
                }
            }
        }
        if (donutElement) donutElement.textContent = b.join("");
    }

    function animate() {
        A += 0.01;
        B += 0.005;
        renderDonut();
        requestAnimationFrame(animate);
    }

    // Start animation when component loads
    animate();
</script>
