---
import FirefoxWindow from "../FirefoxWindow.astro";

// i18n
import { ui } from "@/i18n/ui";
const lang = (Astro.currentLocale || "es") as "es" | "en";
const t = ui[lang];

// Web3Forms Access Key from environment variable
const accessKey = import.meta.env.VITE_WEB3FORMS_ACCESS_KEY || "";
---

<FirefoxWindow
    title={t.email.title}
    url="https://outlook.live.com/mail"
    favicon="web"
    className="w-[800px] min-w-[800px] max-w-[800px]"
>
    <!-- Outlook Header -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-white rounded flex items-center justify-center">
                <img
                    src="/outlook.webp"
                    alt="Outlook icon"
                    class="w-8 h-8 object-contain"
                />
            </div>
            <div>
                <h1 class="font-bold text-lg">Outlook</h1>
                <p class="text-xs text-blue-100">Microsoft 365</p>
            </div>
        </div>
        <div class="text-sm text-blue-100">
            {t.email.header}
        </div>
    </div>

    <!-- Outlook Toolbar -->
    <div class="bg-gray-50 border-b border-gray-200 p-2">
        <div class="flex items-center gap-2">
            <button class="btn btn-primary btn-sm gap-1" id="send-btn">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
                {t.email.sendButton}
            </button>
            <button class="btn btn-ghost btn-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </svg>
            </button>
            <button class="btn btn-ghost btn-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Email Form -->
    <div class="h-[500px] overflow-y-auto">
        <form class="p-6 space-y-4" id="email-form">
        <!-- Para Field -->
        <div class="grid grid-cols-12 gap-4 items-center">
            <label class="col-span-2 text-sm font-medium text-gray-700 text-right">{t.email.to}</label>
            <div class="col-span-10 relative">
                <input
                    type="email"
                    value="mpenaloza@usm.cl"
                    readonly
                    class="input input-bordered w-full bg-gray-50 text-gray-600"
                />
                <div class="absolute right-2 top-1/2 transform -translate-y-1/2">
                    <svg class="w-4 h-4 text-green-500" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- De Field (From) -->
        <div class="grid grid-cols-12 gap-4 items-center">
            <label class="col-span-2 text-sm font-medium text-gray-700 text-right">{t.email.from}</label>
            <div class="col-span-10">
                <input
                    type="email"
                    id="from-input"
                    placeholder={t.email.fromPlaceholder}
                    class="input input-bordered w-full"
                    required
                />
            </div>
        </div>

        <!-- Asunto Field -->
        <div class="grid grid-cols-12 gap-4 items-center">
            <label class="col-span-2 text-sm font-medium text-gray-700 text-right">{t.email.subject}</label>
            <div class="col-span-10">
                <input
                    type="text"
                    id="subject"
                    placeholder={t.email.subjectPlaceholder}
                    class="input input-bordered w-full"
                    required
                />
            </div>
        </div>

        <div class="divider"></div>

        <!-- Message Body -->
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <label class="text-sm font-medium text-gray-700">{t.email.message}</label>
                <div class="flex gap-1">
                    <!-- Formatting buttons -->
                    <button class="btn btn-ghost btn-xs" title="Negrita">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M15.6 10.79c.97-.67 1.65-1.77 1.65-2.79 0-2.26-1.75-4-4-4H7v14h7.04c2.09 0 3.71-1.7 3.71-3.79 0-1.52-.86-2.82-2.15-3.42zM10 6.5h3c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-3v-3zm3.5 9H10v-3h3.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5z"/>
                        </svg>
                    </button>
                    <button class="btn btn-ghost btn-xs" title="Cursiva">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M10 4v3h2.21l-3.42 8H6v3h8v-3h-2.21l3.42-8H18V4z"/>
                        </svg>
                    </button>
                    <button class="btn btn-ghost btn-xs" title="Subrayado">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 17c3.31 0 6-2.69 6-6V3h-2.5v8c0 1.93-1.57 3.5-3.5 3.5S8.5 12.93 8.5 11V3H6v8c0 3.31 2.69 6 6 6zm-7 2v2h14v-2H5z"/>
                        </svg>
                    </button>
                </div>
            </div>
            <textarea
                id="message-body"
                placeholder={t.email.messagePlaceholder}
                class="textarea textarea-bordered w-full min-h-[200px] resize-none"
                required
            ></textarea>
        </div>

        <!-- Action Buttons -->
        <div class="flex justify-end items-center pt-4">
            <button class="btn btn-primary gap-2" type="submit">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
                {t.email.sendMessage}
            </button>
        </div>
        </form>

            <!-- Info Footer -->
            <div class="text-xs text-gray-500 pt-4 border-t">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    <span>{t.email.encryptionEnabled}</span>
                </div>
                <p class="mt-1">
                    {t.email.responseTime}
                </p>
            </div>
    </div>
</FirefoxWindow>

<style>


    /* Textarea styling */
    .textarea {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.5;
    }

    /* Outlook-style colors */
    .btn-primary {
        background: #0078d4;
        border-color: #0078d4;
    }

    .btn-primary:hover {
        background: #106ebe;
        border-color: #106ebe;
    }

    /* Form validation styling */
    input:required:invalid {
        border-color: #ef4444;
    }

    input:required:valid {
        border-color: #10b981;
    }

    /* Custom scrollbar for content area */
    .overflow-auto::-webkit-scrollbar {
        width: 8px;
    }

    .overflow-auto::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .overflow-auto::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .overflow-auto::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>

<script is:inline define:vars={{ accessKey, t }}>
    document.addEventListener('DOMContentLoaded', function() {

        // Handle form submission
        const form = document.getElementById('email-form');
        const submitBtn = document.querySelector('button[type="submit"]');

        if (form && submitBtn) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();

                // Capturar datos del formulario
                const fromEmail = document.getElementById('from-input').value;
                const subject = document.getElementById('subject').value;
                const messageBody = document.getElementById('message-body').value;

                // Validación
                if (!fromEmail || !subject || !messageBody) {
                    window.notifications?.warning(t.email.notifications.fieldsRequired.message, {
                        title: t.email.notifications.fieldsRequired.title
                    });
                    return;
                }

                // Estado "Enviando..."
                submitBtn.innerHTML = `
                    <span class="loading loading-spinner loading-sm"></span>
                    ${t.email.sending}
                `;
                submitBtn.disabled = true;

                try {
                    // Preparar datos para Web3Forms
                    const formData = {
                        access_key: accessKey,
                        subject: subject,
                        email: fromEmail,
                        message: `De: ${fromEmail}\n\nMensaje:\n${messageBody}`
                    };

                    // Enviar email a través de Web3Forms
                    const response = await fetch("https://api.web3forms.com/submit", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                        },
                        body: JSON.stringify(formData),
                    });

                    const result = await response.json();

                    if (result.success) {
                        // Éxito
                        window.notifications?.success(t.email.notifications.emailSent.message, {
                            title: t.email.notifications.emailSent.title,
                            duration: 6000
                        });

                        // Limpiar formulario
                        document.getElementById('from-input').value = '';
                        document.getElementById('subject').value = '';
                        document.getElementById('message-body').value = '';
                    } else {
                        console.error("Error del servicio:", result);
                        window.notifications?.error(t.email.notifications.sendError.message, {
                            title: t.email.notifications.sendError.title
                        });
                    }
                } catch (error) {
                    console.error("Error de red:", error);
                    window.notifications?.error(t.email.notifications.connectionError.message, {
                        title: t.email.notifications.connectionError.title
                    });
                } finally {
                    // Restaurar botón
                    submitBtn.innerHTML = `
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                        ${t.email.sendMessage}
                    `;
                    submitBtn.disabled = false;
                }
            });
        }

        // Auto-resize textarea
        const textarea = document.querySelector('textarea');
        if (textarea) {
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.max(200, this.scrollHeight) + 'px';
            });
        }
    });
</script>
